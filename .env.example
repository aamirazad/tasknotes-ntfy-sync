# Copy to .env, replace every placeholder, and run: chmod 0600 .env
OBSIDIAN_REMOTE_VAULT=your-unique-remote-vault-name
OBSIDIAN_DEEP_LINK_VAULT=your-phone-vault-name
OBSIDIAN_AUTH_TOKEN=replace-with-auth-token
OBSIDIAN_E2EE_PASSWORD=replace-with-e2ee-password
NTFY_TOPIC=replace-with-a-high-entropy-topic

DATA_ROOT=/data
VAULT_ROOT=/data/vault
DATABASE_PATH=/data/notifier/reminders.sqlite3
HEALTH_PATH=/data/notifier/health.json
SYNC_HEALTH_PATH=/data/notifier/sync-health.json
TASKS_PATH=Efforts/Tasks
TASK_PROPERTY_NAME=base
TASK_PROPERTY_VALUE=[[Tasks.base]]
TIMEZONE=America/New_York
DATE_ONLY_TIME=07:00
COMPLETED_STATUSES=Done,Not doing
PRIORITY_MAP_JSON={"None":3,"Low":2,"Medium":3,"High":4,"Urgent":5}
NTFY_BASE_URL=https://ntfy.sh
BODY_MAX_BYTES=1000
RECONCILE_INTERVAL_SECONDS=60
WATCH_DEBOUNCE_MS=500
DUE_POLL_SECONDS=5
MISSED_REMINDER_GRACE_SECONDS=900
NTFY_TIMEOUT_SECONDS=10
LOG_LEVEL=INFO
